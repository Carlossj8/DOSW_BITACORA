        <!-- Sistema Central (C4 Software System) -->
        <mxCell id="techcup" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontStyle=0;" value="&lt;b&gt;Tech Cup Fútbol&lt;/b&gt;&#xa;&lt;i&gt;[Software System]&lt;/i&gt;&#xa;&#xa;Plataforma web centralizada que gestiona el ciclo completo del torneo." vertex="1">
